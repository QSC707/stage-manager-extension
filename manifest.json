{
  "manifest_version": 3,
  "name": "Stage Manager for Browser (台前调度)",
  "version": "1.2.5",
  "description": "macOS 风格的网页台前调度扩展，以 3D 视觉长廊、实时缩略图与多任务编组革新浏览器标签页切换体验。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开台前调度 (Stage Manager)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "呼出/关闭台前调度侧边栏"
    }
  }
}
